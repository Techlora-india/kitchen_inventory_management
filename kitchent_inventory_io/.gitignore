# VS Code files
.pio
.cache
.dummy
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
compile_commands.json

# 1. Allow Git into the .pio directory, but ignore everything directly inside it
!.pio/
.pio/*

# 2. Allow Git into the build directory, but ignore everything directly inside it
!.pio/build/
.pio/build/*

# 3. Allow Git into the seeed_xiao_esp32c3 directory, but ignore everything directly inside it
!.pio/build/seeed_xiao_esp32c3/
.pio/build/seeed_xiao_esp32c3/*

# 4. Explicitly allow ONLY the firmware.bin file
!.pio/build/seeed_xiao_esp32c3/firmware.bin